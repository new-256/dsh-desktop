# Normalize text files to LF in the repository, check out native on Windows.
* text=auto

# Windows-only shell scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# NSIS include scripts are text.
*.nsh text

# Binary assets: never diff or normalize.
*.ico binary
*.png binary
*.jpg binary
*.exe binary
*.dll binary
*.node binary
*.blockmap binary
