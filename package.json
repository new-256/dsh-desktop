{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "0.3.24",
  "description": "DSH (DeepSeek Harness) 桌面版：独立窗口运行 Web GUI，免浏览器，隔离数据目录，启动自动修复，静默更新重启生效。",
  "author": "DSH Desktop Packager",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/new-256/dsh-desktop.git"
  },
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/install-backend.js && node scripts/prepare-runtime.js",
    "start": "electron .",
    "pack-vendor": "node scripts/pack-vendor.js",
    "dist": "node scripts/pack-vendor.js && electron-builder --win",
    "dist:dir": "node scripts/pack-vendor.js && electron-builder --win --dir",
    "make-icon": "node scripts/make-icon.js",
    "prepare-runtime": "node scripts/prepare-runtime.js"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.deepseek.dshdesktop",
    "productName": "DSH Desktop",
    "copyright": "MIT",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater-backend.js",
      "diag-log.js",
      "splash.html",
      "assets/**/*",
      "!vendor/**/*",
      "!release/**/*",
      "!scripts/**/*"
    ],
    "extraResources": [
      {
        "from": "build/payload",
        "to": "payload",
        "filter": [
          "*.7z"
        ]
      },
      {
        "from": "node_modules/7zip-bin/win/x64/7za.exe",
        "to": "payload/7za.exe"
      }
    ],
    "asarUnpack": [
      "**/*.{node,dll,exe}"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH Desktop",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
